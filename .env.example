# Copy to .env for defaults; use .env.local for secrets (both gitignored).
HOST=0.0.0.0
PORT=3000

# Upload limits
MAX_FILE_SIZE_MB=50
MAX_FILES=20

# Adobe PDF Services — OPTIONAL. Only for /library → /tools/* (not /combine or /split).
# /combine and /split are 100% local (pdf-lib); leave these blank if you don't use Adobe tools.
# From pdfservices-api-credentials.json (see README).
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=
