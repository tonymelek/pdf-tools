# Copy to `.env.docker` for Docker Compose:
#   cp .env.docker.example .env.docker
#
# Combine (/combine) and split (/split) work with NO Adobe keys.
# Only fill PDF_SERVICES_* if you use /library Adobe tools.

HOST=0.0.0.0
PORT=3000

MAX_FILE_SIZE_MB=50
MAX_FILES=20

# Optional — Adobe PDF Services (library tools only)
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=
